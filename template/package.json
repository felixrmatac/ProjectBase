{
  "name": "project",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "mkdir -p src/types && supabase gen types typescript --local > src/types/database.ts",
    "quality-gate": "npm run check && npm run lint && npm run test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.15.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.2.1",
    "vitest": "^3.0.9"
  }
}
